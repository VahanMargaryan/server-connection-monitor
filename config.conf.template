#===============================================================================
# Server Connection Monitor Configuration
#
# Edit this file with your settings after installation.
# Location: /etc/connection-monitor/config.conf
#===============================================================================

#-------------------------------------------------------------------------------
# TELEGRAM CONFIGURATION (REQUIRED)
#-------------------------------------------------------------------------------

# Your Telegram Bot Token
# Get it from @BotFather: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=""

# Your Telegram Chat ID
# Get it from @userinfobot: https://t.me/userinfobot
# For groups, use the group chat ID (starts with -)
TELEGRAM_CHAT_ID=""

#-------------------------------------------------------------------------------
# SERVER IDENTIFICATION
#-------------------------------------------------------------------------------

# Custom server name (auto-detected if empty)
# Used in notifications and to route callback actions
SERVER_NAME=""

# Server IP address (auto-detected if empty)
SERVER_IP=""

# SSH port (used by "Show Active Sessions" to list SSH connections)
SSH_PORT="22"

#-------------------------------------------------------------------------------
# NOTIFICATION FILTERS
#-------------------------------------------------------------------------------

# Users to exclude from notifications (space-separated)
# Example: EXCLUDED_USERS="root backup monitoring"
EXCLUDED_USERS=""

# IPs to exclude from notifications (space-separated)
# Example: EXCLUDED_IPS="192.168.1.100 10.0.0.1"
EXCLUDED_IPS=""

# PAM services that never trigger alerts (space-separated). Prevents
# false-positive notifications from cron jobs, sudo/su, the systemd user
# manager, password tools and display managers.
IGNORED_SERVICES="cron crond sudo su su-l runuser runuser-l systemd-user polkit-1 passwd chpasswd chsh chfn newgrp gdm-password gdm-launch-environment lightdm sddm xdm"

# Notify on local sessions that have no remote IP (console / TTY logins).
# Set to "false" to alert only on genuine remote (network) connections.
NOTIFY_LOCAL="true"

# Also monitor console / serial logins (e.g. Proxmox xterm.js, physical console)
# by hooking the `login` PAM service in addition to sshd. These logins have no
# remote IP, so they appear as "Local Console Login" from "Local/Unknown".
# Re-run the installer (install/update) after changing this so PAM is updated.
MONITOR_CONSOLE="false"

#-------------------------------------------------------------------------------
# BEHAVIOR OPTIONS
#-------------------------------------------------------------------------------

# Deduplication window in seconds
# Prevents duplicate notifications for same user+IP within this window
DEDUP_WINDOW="10"

# Enable geo-location lookup for IP addresses
# Requires internet access to ip-api.com
GEO_LOOKUP="true"

# Enable debug logging
# Logs to /var/log/connection-monitor.log
DEBUG="false"
